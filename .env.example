# APInspect Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# OpenRouter API key — required for checklist-driven (--checklist) scan mode.
# Get yours at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional fallback key. If the primary key hits a rate/quota limit (429/402/403),
# openrouterClient.js switches to this one for the rest of the run.
OPENROUTER_API_KEY_ALT=
